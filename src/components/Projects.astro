---
import GitHub from "./icons/GitHub.astro";
import AngularIcon from "./icons/Angular.astro";
import NestIcon from "./icons/Nest.astro";
import XRPLIcon from "./icons/Xrpl.astro";
import EthereumIcon from "./icons/Ethereum.astro";
import SolanaIcon from "./icons/Solana.astro";
import IonicIcon from "./icons/Ionic.astro";
import TelegramIcon from "./icons/Telegram.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";

const TAGS = {
  ANGULAR: {
    name: "Angular",
    class: "bg-[#7b15fc] text-white",
    icon: AngularIcon
  },
  NESTJS:{
    name: "Nestjs",
    class: "bg-[#e1224e] text-white",
    icon: NestIcon
  },
  XRPL: {
    name: "XRPL",
    class: "bg-white text-black",
    icon: XRPLIcon
  },
  WEB3:{
    name: "Web3",
    class: "bg-[#81a9fa] text-white",
    icon: EthereumIcon
  },
  SOLANA:{
    name: "Solana",
    class: "bg-[#14F195] text-black",
    icon: SolanaIcon
  },
  IONIC:{
    name: "Ionic",
    class: "bg-white text-black",
    icon: IonicIcon
  },
  TELEGRAM:{
    name: "Telegram",
    class: "bg-[#0084C9] text-white color-white",
    icon: TelegramIcon
  },
}
const PROJECTS = [
  {
    title: "PontiX - Bridge currency exchange",
    description:
      "Dapp that serves as a bridge for the exchange of cryptocurrencies such as XRP, ETH, BSC, SOLANA, AVAX, among others",
    link: "https://webapp.pontix.io/",
    image: "/projects/pontix.webp",
    tags: [TAGS.ANGULAR, TAGS.NESTJS, TAGS.WEB3, TAGS.XRPL, TAGS.SOLANA],
  },
  {
    title: "Non Fungible - Non Fungible NFT Viewer",
    description:
      "Non Fungible (NF) is a Xaman xApp to manage and interact with all aspects of XRP Ledger NFTs issued via the XLS-20 standard, regardless of issuer or marketplace.",
    link: "https://nftltd.im/products/",
    image: "/projects/non-fungible.webp",
    tags: [TAGS.IONIC, TAGS.NESTJS, TAGS.XRPL, TAGS.ANGULAR],
  },
  {
    title: "p2pbet - Friendly peer-to-peer bets on the XRPL",
    description:
      "Xaman Interactive xApp for betting, peer to peer on the XRPL blockchain, with a Telegram bot and MiniApp.",
    link: "https://p2pbet.app/",
    image: "/projects/p2pbet.webp",
    tags: [TAGS.IONIC, TAGS.TELEGRAM, TAGS.NESTJS, TAGS.XRPL, TAGS.SOLANA],
  },
  {
    title: "CasinoCoin Lobby ",
    description:
      "Xapp where users can join regulated gambling sites, almost instant deposits and withdrawals and exclusive offers.",
    link: "https://casinocoin.im/getting-started/",
    image: "/projects/casinocoin.webp",
    tags: [TAGS.IONIC, TAGS.NESTJS, TAGS.XRPL],
  },
]
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link }) => (
    <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
  <div class="w-full md:w-1/2">
    <div class="relative flex flex-col items-center h-56 col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
      <img alt={title} class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105" loading="lazy" src={image} />
    </div>
  </div>

  <div class="w-full md:w-1/2 md:max-w-lg">
    <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
      {title}
    </h3>
    <div class="flex flex-wrap mt-2">
      <ul class="flex flex-row mb-2 gap-x-2 overflow-auto">
          {tags.map((tag) => (
            <li>
              <span
                class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
              >
                <tag.icon class="size-4" />
                {tag.name}
              </span>
            </li>
          ))}
        </ul>

      <div class="mt-2 text-gray-700 dark:text-gray-400">{description}</div>
      <footer class="flex items-end justify-start mt-4 gap-x-4">
        {link && (
          <LinkButton href={link}>
            <Link class="size-4" />
            Preview
          </LinkButton>
        )}
      </footer>
    </div>
  </div>
</article>
    ))
  }
</div>



